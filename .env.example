# ============================================================
# Stripe Connect Partner Marketplace Environment Variables
# ============================================================

# ============================================================
# Stripe Configuration for Subscriptions
# ============================================================

# Stripe API Keys
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_... # Use sk_live_... for production
STRIPE_PUBLISHABLE_KEY=pk_test_... # Use pk_live_... for production
VITE_STRIPE_PUBLIC_KEY=pk_test_... # Same as STRIPE_PUBLISHABLE_KEY

# Stripe Subscription Webhook Secret
# Create webhook at: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://your-domain.netlify.app/.netlify/functions/stripe-webhook
# Events: customer.subscription.created, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_succeeded,
#         invoice.payment_failed, checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Payment Links (Recommended - Easy Setup)
# Create at: https://dashboard.stripe.com/payment-links
# 1. Create a Payment Link for each subscription tier
# 2. Enable "Collect customer details" and "Collect phone number"
# 3. Copy the link URL (e.g., https://buy.stripe.com/xxxx)
VITE_STRIPE_ESSENTIAL_PAYMENT_LINK=https://buy.stripe.com/your_essential_link
VITE_STRIPE_EXPLORER_PAYMENT_LINK=https://buy.stripe.com/your_explorer_link
VITE_STRIPE_TRAVELLER_PAYMENT_LINK=https://buy.stripe.com/your_traveller_link
VITE_STRIPE_ELITE_PAYMENT_LINK=https://buy.stripe.com/your_elite_link
# Legacy aliases (for backwards compatibility)
VITE_STRIPE_STARTER_PAYMENT_LINK=https://buy.stripe.com/your_starter_link
VITE_STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/your_pro_link

# OR Stripe Price IDs (For Checkout Sessions - More Control)
# Create Products at: https://dashboard.stripe.com/products
# Essential: $19/month, Explorer: $99/month, Traveller: $199/month, Elite: $999/month
VITE_STRIPE_ESSENTIAL_PRICE_ID=price_...
VITE_STRIPE_EXPLORER_PRICE_ID=price_...
VITE_STRIPE_TRAVELLER_PRICE_ID=price_...
VITE_STRIPE_ELITE_PRICE_ID=price_...
# Legacy aliases (for backwards compatibility)
VITE_STRIPE_STARTER_PRICE_ID=price_...
VITE_STRIPE_PRO_PRICE_ID=price_...

# Stripe Connect
# Client ID from: https://dashboard.stripe.com/settings/applications
STRIPE_CONNECT_CLIENT_ID=ca_...

# Stripe Webhook Secrets
# Create webhook endpoint at: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://your-api-domain.com/webhooks/stripe-connect
# Events to listen for:
#   - account.updated
#   - account.application.deauthorized
#   - transfer.created
#   - transfer.updated
#   - transfer.failed
#   - payout.paid
#   - payout.failed
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Supabase
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API Configuration
# Backend API base URL (Node.js/Express server)
VITE_API_BASE_URL=http://localhost:3000/api # Update for production
FRONTEND_URL=http://localhost:5173 # Update for production

# Commission Rates (optional - defaults are in code)
# COMMISSION_RATE_TAXI=0.10
# COMMISSION_RATE_LUXURY_CAR=0.12
# COMMISSION_RATE_ADVENTURE=0.15

# Payout Settings (optional)
# PAYOUT_SCHEDULE=daily
# PAYOUT_DELAY_DAYS=2

# ============================================================
# Other Existing Environment Variables
# ============================================================

# Hume AI (for voice features)
VITE_HUME_API_KEY=...
VITE_HUME_CONFIG_ID=...

# Mapbox (required for ground transport, maps, AI transfer distance tools)
# Create at https://account.mapbox.com/ — scopes: Geocoding, Directions, GL JS
# Must be set in production (Vercel/Netlify) before deploying mapbox env-only refactor
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Google Places API (for luxury travel planning venue verification)
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API, Geocoding API
VITE_GOOGLE_PLACES_API_KEY=...

# Google Calendar Integration
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Add authorized redirect URIs: http://localhost:5173/auth/google/callback, https://your-domain.com/auth/google/callback
# 3. Copy Client ID and Client Secret
VITE_GOOGLE_CLIENT_ID=...
VITE_GOOGLE_CLIENT_SECRET=...
# Also add these to Supabase Edge Function secrets:
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# ExchangeRate-API (for USD currency conversion)
# Get your free key from: https://www.exchangerate-api.com/
# Free tier: 1,500 requests/month (with 24-hour caching, ~30 requests/month)
VITE_EXCHANGERATE_API_KEY=your_api_key_here
# Also add to Supabase Edge Function secrets as EXCHANGERATE_API_KEY

# Other integrations
VITE_OPENAI_API_KEY=...

# Anthropic Claude AI (for AI Chat assistant)
# Get your key from: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=sk-ant-api...

# Ticketmaster Discovery API
# Get your key from: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
VITE_TICKETMASTER_CONSUMER_KEY=...

# Eventbrite API
# Get your token from: https://www.eventbrite.com/platform/api
VITE_EVENTBRITE_TOKEN=...

# ============================================================
# Escrow System Configuration
# ============================================================

# Pinata for IPFS (escrow contract storage - FREE 1GB)
# Get your free JWT from: https://app.pinata.cloud/developers/api-keys
# Steps:
# 1. Create FREE account at https://pinata.cloud
# 2. Go to "API Keys" section
# 3. Create new API key with "pinFileToIPFS" permission
# 4. Copy the JWT token (starts with "eyJ...")
# 5. Paste below
VITE_PINATA_JWT=

# Development Mode (escrow system)
# Set to 'true' to skip IPFS upload during development (uses mock CID)
# Set to 'false' for production (uploads to Pinata)
VITE_DEV_MODE=true

# ============================================================
# AWS SES Email Configuration (for Supabase Edge Functions)
# ============================================================
# These are configured in Supabase Edge Function secrets, not in .env
# Required secrets for chat-support-notifications function:
# - AWS_ACCESS_KEY_ID
# - AWS_SECRET_ACCESS_KEY
# - AWS_REGION (default: eu-north-1)
# - FROM_EMAIL (default: noreply@www.privatecharterx.com)
# - SUPPORT_EMAIL (default: support@privatecharterx.com)

# ============================================================
# Polymesh Blockchain Configuration
# ============================================================
# Polymesh is used for security token issuance and compliance

# Polymesh Network (mainnet or testnet)
VITE_POLYMESH_NETWORK=mainnet

# Polymesh Node URL (WebSocket RPC endpoint)
# Mainnet: wss://mainnet-rpc.polymesh.network
# Testnet: wss://testnet-rpc.polymesh.live
VITE_POLYMESH_NODE_URL=wss://mainnet-rpc.polymesh.network

# Polymesh Middleware/GraphQL URL (for queries)
# Mainnet: https://mainnet-graphql.polymesh.network
# Testnet: https://testnet-graphql.polymesh.live
VITE_POLYMESH_MIDDLEWARE_URL=https://mainnet-graphql.polymesh.network

# Polymesh Signing Mnemonic (KEEP SECRET - for server-side only)
# Only needed for creating transactions, not for read-only access
# 12-word mnemonic phrase for the signing account
# POLYMESH_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Polymesh Account DID (Decentralized Identifier)
# The DID of the PrivateCharterX platform identity
# VITE_POLYMESH_PLATFORM_DID=0x...
