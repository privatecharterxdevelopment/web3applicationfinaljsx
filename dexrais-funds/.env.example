# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# WalletConnect / Reown AppKit
# Get your Project ID from: https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your-project-id-here

# Platform Configuration
# Your wallet address where launch fees will be sent
VITE_PLATFORM_WALLET=0xYourWalletAddressHere

# USDC Contract (Base Chain)
VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Pricing Configuration
VITE_CHF_TO_USDC=1.10

# Network Configuration
VITE_CHAIN_ID=8453

# Resend Email Service
# Get your API key from: https://resend.com/api-keys
# For testing, use: re_bY4MQ2RD_NQoMPjbvqBWy89cpn7VpiNLt
VITE_RESEND_API_KEY=your-resend-api-key-here
