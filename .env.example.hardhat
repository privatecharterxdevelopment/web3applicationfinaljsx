# ================================================
# HARDHAT & SMART CONTRACT DEPLOYMENT
# ================================================

# Deployer wallet private key (KEEP SECRET!)
# Get from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Base Mainnet RPC (optional - defaults to public RPC)
BASE_MAINNET_RPC=https://mainnet.base.org

# Base Sepolia Testnet RPC (optional - defaults to public RPC)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Basescan API Key (for contract verification)
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# Etherscan API Key (for Sepolia verification)
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ================================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================================

# Deployed contract address (set after deployment)
VITE_ESCROW_CONTRACT_ADDRESS=0x...

# Network name (base or baseSepolia)
VITE_ESCROW_NETWORK=baseSepolia

# Treasury address (configured in contract)
VITE_TREASURY_ADDRESS=0xe2eeCBbfE60d013e93c7dC4da482E6657Ee7801b

# ================================================
# NOTES
# ================================================

# SECURITY:
# - NEVER commit .env file to git
# - NEVER share your PRIVATE_KEY
# - Use different wallets for testnet/mainnet
# - Keep minimum balance in deployment wallet

# DEPLOYMENT STEPS:
# 1. Copy this file to .env
# 2. Fill in your PRIVATE_KEY
# 3. Get BASESCAN_API_KEY from basescan.org
# 4. Deploy to testnet first:
#    npx hardhat run scripts/deploy-base.cjs --network baseSepolia
# 5. Test thoroughly on testnet
# 6. Deploy to mainnet:
#    npx hardhat run scripts/deploy-base.cjs --network base
# 7. Update VITE_ESCROW_CONTRACT_ADDRESS in .env

# NETWORK INFO:
# Base Mainnet - ChainID: 8453
# Base Sepolia - ChainID: 84532
# Block Explorer: https://basescan.org (mainnet)
# Block Explorer: https://sepolia.basescan.org (testnet)

# GAS ESTIMATES (Base Network):
# - Contract Deployment: ~2M gas (~$0.50 @ 1 gwei)
# - Create Escrow: ~215K gas (~$0.05)
# - Release Funds: ~127K gas (~$0.03)
# - Raise Dispute: ~55K gas (~$0.01)
